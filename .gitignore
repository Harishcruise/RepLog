# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# supabase local
/supabase/.branches
/supabase/.temp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# `npx skills add` — real source lives in .agents/skills (committed) + skills-lock.json;
# this is a local symlink into it for Claude Code's own skill discovery, regenerated by
# `npx skills add`/`npx skills sync`. On this machine git can't preserve the symlinks
# (core.symlinks=false), so tracking it would duplicate every skill file's full content.
.claude/skills
